<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressed/Expanded state -->
    <item android:state_pressed="true">
        <layer-list>
            <!-- Main background -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/background_card" />
                    <stroke
                        android:width="2dp"
                        android:color="#64B5F6" />
                    <corners android:radius="4dp" />
                    <padding
                        android:left="16dp"
                        android:top="12dp"
                        android:right="40dp"
                        android:bottom="12dp" />
                </shape>
            </item>
            
            <!-- Up arrow when expanded -->
            <item android:gravity="center_vertical|right" android:right="12dp">
                <rotate android:fromDegrees="180" android:toDegrees="180">
                    <vector xmlns:android="http://schemas.android.com/apk/res/android"
                        android:width="24dp"
                        android:height="24dp"
                        android:viewportWidth="24"
                        android:viewportHeight="24">
                        <path
                            android:fillColor="@color/text_secondary"
                            android:pathData="M7,10l5,5 5,-5z" />
                    </vector>
                </rotate>
            </item>
        </layer-list>
    </item>
    
    <!-- Normal/Collapsed state -->
    <item>
        <layer-list>
            <!-- Main background -->
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/background_card" />
                    <stroke
                        android:width="2dp"
                        android:color="#64B5F6" />
                    <corners android:radius="4dp" />
                    <padding
                        android:left="16dp"
                        android:top="12dp"
                        android:right="40dp"
                        android:bottom="12dp" />
                </shape>
            </item>
            
            <!-- Down arrow when collapsed -->
            <item android:gravity="center_vertical|right" android:right="12dp">
                <vector xmlns:android="http://schemas.android.com/apk/res/android"
                    android:width="24dp"
                    android:height="24dp"
                    android:viewportWidth="24"
                    android:viewportHeight="24">
                    <path
                        android:fillColor="@color/text_secondary"
                        android:pathData="M7,10l5,5 5,-5z" />
                </vector>
            </item>
        </layer-list>
    </item>
</selector>