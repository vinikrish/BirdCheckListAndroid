<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Shadow layer (inset shadow for input fields) -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#40000000" />
            <corners android:radius="8dp" />
        </shape>
    </item>
    
    <!-- Main input field layer -->
    <item android:top="2dp" android:left="2dp" android:bottom="1dp" android:right="1dp">
        <layer-list>
            <!-- Background gradient -->
            <item>
                <shape android:shape="rectangle">
                    <gradient
                        android:startColor="#424242"
                        android:endColor="#383838"
                        android:angle="90" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
            
            <!-- Inner highlight -->
            <item android:top="1dp" android:left="1dp" android:right="1dp">
                <shape android:shape="rectangle">
                    <stroke
                        android:width="1dp"
                        android:color="#20FFFFFF" />
                    <corners android:radius="7dp" />
                </shape>
            </item>
            
            <!-- Border -->
            <item>
                <shape android:shape="rectangle">
                    <stroke
                        android:width="2dp"
                        android:color="#616161" />
                    <corners android:radius="8dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</layer-list>