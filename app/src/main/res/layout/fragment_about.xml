<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- App Description -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="About BirdCheckList"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="BirdCheckList is a comprehensive bird watching app that helps you track and manage your bird observations. Record your sightings, build your life list, and keep detailed notes about the birds you encounter in the wild."
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Icon Explanations Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Icon Meanings"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginBottom="16dp" />

        <!-- Female Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/female"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Female"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Indicates that a female bird was observed"
                    android:textSize="14sp"
                    android:textColor="#666" />

            </LinearLayout>
        </LinearLayout>

        <!-- Male Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/male"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Male"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Indicates that a male bird was observed"
                    android:textSize="14sp"
                    android:textColor="#666" />

            </LinearLayout>
        </LinearLayout>

        <!-- Saw Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_saw"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Saw"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Indicates that the bird was visually observed"
                    android:textSize="14sp"
                    android:textColor="#666" />

            </LinearLayout>
        </LinearLayout>

        <!-- Photographed Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_photographed"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Photographed"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Indicates that the bird was photographed"
                    android:textSize="14sp"
                    android:textColor="#666" />

            </LinearLayout>
        </LinearLayout>

        <!-- Heard Icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="24dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_heard"
                android:layout_marginEnd="16dp" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Heard"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Indicates that the bird was heard but not necessarily seen"
                    android:textSize="14sp"
                    android:textColor="#666" />

            </LinearLayout>
        </LinearLayout>

        <!-- Features Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Features"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1976D2"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="• Track bird sightings with detailed observation data\n• Build and maintain your personal life list\n• Record gender-specific observations\n• Note different types of encounters (visual, auditory, photographic)\n• Organize birds alphabetically for easy browsing\n• Sync your data across devices with cloud storage"
            android:textSize="16sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginBottom="24dp" />

        <!-- Privacy Statement Section -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Privacy Policy"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/text_primary"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Effective Date: January 2025\n\nData Collection and Use:\nWe collect the following types of data to provide our bird tracking services:\n\n• Personal Information: Email address and name for account creation and authentication\n• Location Data: Approximate location to automatically detect your country for bird list filtering\n• Bird Observation Data: Your bird sightings, photos, and notes stored securely in Firebase\n• Device Information: Basic device identifiers for app functionality\n\nThird-Party Services:\nThis app uses the following third-party services that may collect data:\n\n• Google Firebase: For secure data storage and user authentication\n• Google Sign-In: For account creation and login\n• Google AdMob: For displaying advertisements (contains ads)\n• Google Play Services: For location services and app functionality\n\nData Security:\nAll personal and sensitive data is transmitted using modern encryption (HTTPS) and stored securely in Google Firebase with industry-standard security measures.\n\nData Retention and Deletion:\nYour data is retained as long as your account is active. You may request data deletion by contacting us or deleting your account.\n\nUser Rights:\nYou have the right to:\n• Access your personal data\n• Correct inaccurate data\n• Delete your account and data\n• Withdraw consent for data processing\n\nData Sharing:\nWe do not sell your personal data. Data may only be shared:\n• With your explicit consent\n• For legal compliance\n• With service providers under strict confidentiality agreements\n\nContact:\nFor privacy questions or data requests, please contact us at:\nEmail: support@devheaven.link\nDeveloper: devheaven.link\n\nYou can also reach us through the app settings menu."
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:layout_marginBottom="16dp"
            android:lineSpacingExtra="2dp" />

        <!-- Version Info -->
        <TextView
            android:id="@+id/version_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Version 1.3 (Build 4)\nDeveloped for bird enthusiasts worldwide"
            android:textSize="14sp"
            android:textColor="#888"
            android:gravity="center"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>